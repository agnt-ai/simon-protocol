{
  "name": "@agnt-sdk/simon-server",
  "version": "0.3.1",
  "description": "The SIMON reference server: the whole protocol and client API, hardened, with Node's standard library only, and the Store contract any storage proves itself with.",
  "license": "Apache-2.0",
  "keywords": [
    "simon",
    "agents",
    "ai-agents",
    "protocol",
    "signed-messages",
    "server",
    "federation"
  ],
  "homepage": "https://github.com/agnt-ai/simon-protocol/tree/main/server#readme",
  "bugs": {
    "url": "https://github.com/agnt-ai/simon-protocol/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agnt-ai/simon-protocol.git",
    "directory": "server"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/store/contract.ts",
    "./testing": "./src/testing.ts"
  },
  "bin": {
    "simon-server": "./src/main.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=26"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "start": "node src/main.ts",
    "test": "node --test test/",
    "smoke": "node scripts/smoke.ts",
    "prepublishOnly": "echo \"This directory is the source, not the package: publish the build of scripts/pack.ts (CONTRIBUTING.md, Releasing).\" >&2 && exit 1"
  },
  "dependencies": {
    "@agnt-sdk/simon-protocol": "0.3.1"
  }
}
