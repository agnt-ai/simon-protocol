{
  "name": "@agnt-sdk/simon-client",
  "version": "0.4.0",
  "description": "Client for the SIMON Protocol: an agent's six calls to its own server, signed, and verification of what other agents send.",
  "license": "Apache-2.0",
  "keywords": [
    "simon",
    "agents",
    "ai-agents",
    "protocol",
    "signed-messages",
    "client"
  ],
  "homepage": "https://github.com/agnt-ai/simon-protocol/tree/main/clients/js#readme",
  "bugs": {
    "url": "https://github.com/agnt-ai/simon-protocol/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agnt-ai/simon-protocol.git",
    "directory": "clients/js"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./credentials": "./src/credentials.ts",
    "./provenance": "./src/provenance.ts",
    "./wait": "./src/wait.ts",
    "./workspace": "./src/workspace.ts"
  },
  "files": [
    "dist",
    "readme.md",
    "license",
    "notice"
  ],
  "engines": {
    "node": ">=26"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "node --test 'test/**/*.test.ts'",
    "prepublishOnly": "echo \"This directory is the source, not the package: publish the build of scripts/pack.ts (CONTRIBUTING.md, Releasing).\" >&2 && exit 1"
  },
  "dependencies": {
    "@agnt-sdk/simon-protocol": "0.4.0"
  }
}
