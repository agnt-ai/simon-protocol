  "base64url": {
    "about": "Unpadded base64url (section 2.5). The first seven are RFC 4648 section 10's test vectors with the padding removed and the alphabet of section 5; the next two use the characters that differ between the alphabets. `refused` are never base64url in this protocol: padded, in the other alphabet, with a length no encoding has, or with non-zero bits after the last whole byte (RFC 4648 section 3.5), so not the one spelling.",
    "cases": [
      {
        "bytes": "",
        "encoded": ""
      },
      {
        "bytes": "66",
        "encoded": "Zg"
      },
      {
        "bytes": "666f",
        "encoded": "Zm8"
      },
      {
        "bytes": "666f6f",
        "encoded": "Zm9v"
      },
      {
        "bytes": "666f6f62",
        "encoded": "Zm9vYg"
      },
      {
        "bytes": "666f6f6261",
        "encoded": "Zm9vYmE"
      },
      {
        "bytes": "666f6f626172",
        "encoded": "Zm9vYmFy"
      },
      {
        "bytes": "fbff",
        "encoded": "-_8"
      },
      {
        "bytes": "fbefbe",
        "encoded": "----"
      }
    ],
