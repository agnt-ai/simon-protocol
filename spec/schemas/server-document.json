{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "server-document.json",
  "title": "AGNT server document",
  "description": "GET /agnt/server. At most 131072 bytes and 32 TOTAL key entries, including retained revoked keys. Unknown members are ignored; sizes, exact origin, key validity and authorization require semantic checks.",
  "type": "object",
  "required": ["server", "keys", "algorithms", "limits"],
  "properties": {
    "server": {
      "$ref": "common.json#/$defs/origin"
    },
    "keys": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "common.json#/$defs/keyEntry"
      },
      "description": "At most 32 total entries, not merely 32 active keys."
    },
    "algorithms": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "allOf": [
        {
          "contains": {
            "const": "ed25519"
          }
        },
        {
          "contains": {
            "const": "ml-dsa-65"
          }
        }
      ]
    },
    "limits": {
      "type": "object",
      "required": ["messageBytes", "recipients", "requestBodyBytes", "partBytes"],
      "properties": {
        "messageBytes": {
          "type": "integer",
          "minimum": 262144,
          "maximum": 9007199254740991
        },
        "recipients": {
          "type": "integer",
          "minimum": 100,
          "maximum": 9007199254740991
        },
        "requestBodyBytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 9007199254740991
        },
        "partBytes": {
          "type": "integer",
          "minimum": 26214400,
          "maximum": 9007199254740991
        }
      }
    },
    "syncDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Positive whole days of sync retention; an incomplete or unknown checkpoint fails explicitly."
    },
    "history": {
      "oneOf": [
        {
          "const": false
        },
        {
          "type": "object",
          "properties": {
            "retentionDays": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": ["retentionDays"]
        }
      ],
      "description": "An object advertises CLIENT history/conversation calls with positive whole-day retention or null until removal. Absent or false offers retained sync only; this is not a durable cryptographic archive."
    }
  }
}
